.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==========================================
# OS / EDITOR SPECIFIC
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

