.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml

# ==========================================
# MISC
# ==========================================
*.bak
*.tmp
.DS_Store
v
v
# ==========================================
# PYTHON / BACKEND SPECIFIC
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
